# ------------------------------------------------------------------
# EKMOOL environment template
# Copy to .env.local and fill in. Every third-party section is OPTIONAL:
# the site builds, runs, and takes COD orders with none of them set.
# Signup steps for each service: docs/keys-needed.md
# ------------------------------------------------------------------

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Protects /api/jobs/* (header: x-cron-secret). Generate: openssl rand -hex 32
CRON_SECRET=
# Protects /api/revalidate (header: x-revalidate-secret)
REVALIDATE_SECRET=
# Signs the customer session cookie set at /track. The site works without it,
# but then a per-process secret is generated: every restart signs everyone out
# and multiple instances cannot read each other's cookies. Set it before you
# deploy. Generate: openssl rand -hex 32
SESSION_SECRET=
# Receives low-stock reports and admin alerts
ADMIN_EMAIL=

# ---- Native app clients (GET /api/v1/bootstrap) ----
# The oldest app build the server will still answer correctly. A client below
# it shows "this version is out of date, please update" and stops.
#
# Unset it is 1, which walls off nobody — build numbers start at 1, so every
# client that exists is admitted. A value that is not a whole number falls
# back to 1 rather than becoming NaN, because NaN compares false against a
# build number in both directions and would switch the wall off silently.
#
# RAISE IT ONLY FOR CORRECTNESS. When a server change makes an old build
# place a wrong order, this is the remedy. It is not for retiring a screen or
# pushing a redesign: it takes a working app away from someone until they
# have the connection and the storage to replace it.
MOBILE_MIN_CLIENT_BUILD=
# What that screen says. Unset, the app uses its own built-in wording — this
# exists because the one thing you cannot ship to a client too old to run is
# a new string.
MOBILE_MIN_CLIENT_MESSAGE=

# ---- Seller identity (GST) ----
# ONE SWITCH. All four of the first four together decide both things:
# whether GST is recorded on an order, and whether the invoice is a TAX
# INVOICE. Leave any one blank and no GST is charged and the invoice prints
# headed "pro-forma — not a tax invoice", with no tax columns at all.
#
# They are one switch rather than two because s.32 of the CGST Act forbids an
# unregistered person from collecting tax. A shop without a GSTIN charges no
# GST, so there is nothing to split and nothing to print — and a document
# that said "not registered" while showing a CGST/SGST breakdown would be
# describing a transaction that did not happen.
#
# SELLER_STATE must match a state name exactly as it appears in the checkout
# dropdown: it is what tells CGST+SGST (buyer in your state) from IGST.
#
# Rates and HSN codes are seeded at 5% in migration 003 as a starting point.
# CONFIRM BOTH WITH YOUR CA before issuing a real tax invoice.
SELLER_LEGAL_NAME=
SELLER_GSTIN=
SELLER_STATE=
SELLER_ADDRESS=
# Optional, printed when present:
SELLER_FSSAI=

# ---- Grievance officer ----
# Rule 4(5) of the Consumer Protection (E-Commerce) Rules 2020 REQUIRES a
# named officer with contact details displayed on the site, acknowledgement
# within 48 hours and redressal within a month. The DPDP Act 2023 wants a
# contact point for data grievances, which for a small shop is the same
# person. Name and email are the minimum; phone is shown when set.
#
# Unset, /contact says no officer has been appointed yet and gives the
# escalation route anyway. That is an honest gap rather than a fabricated
# name on a statutory notice — but it IS a gap, so fill it before you trade.
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=

# ---- Cloudflare Turnstile (CAPTCHA) — https://dash.cloudflare.com ----
# Free at any volume, no puzzle for real users, no npm dependency.
# BOTH halves or neither: one without the other is a misconfiguration, and
# the code treats it as unconfigured. Unset, no widget renders and no
# verification call is made — the honeypot on both forms still applies, and
# so does the rate limiter.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Database (MySQL 8 — `npm run db:up` starts the Docker container) ----
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=ekmool
DATABASE_PASSWORD=ekmool_dev
DATABASE_NAME=ekmool
# Set to true against a MANAGED MySQL (Aiven, PlanetScale, RDS, any host
# reached over the internet) — they refuse a plaintext connection. Leave
# unset for the local Docker container, which has no certificate and
# refuses a TLS one. Certificates are verified either way.
DATABASE_SSL=
# The provider's CA certificate, needed when it signs with its own root
# rather than a public one. Aiven does: without this the handshake fails
# with HANDSHAKE_SSL_ERROR — it does NOT quietly fall back to plaintext.
# Paste the PEM with literal \n between lines so it fits one env var.
DATABASE_SSL_CA=
# Used only by docker-compose + scripts, never by the app:
MYSQL_ROOT_PASSWORD=ekmool_root_dev

# ---- Redis (shared rate limits + cache purges across instances) ----
# Optional for one container, required for more than one. Each Node process
# keeps its own in-memory rate-limit buckets, so four replicas turn a 10/min
# checkout limit into forty a minute — and an admin edit purges the cache of
# whichever container served the form while the rest keep serving the old
# catalogue for up to an hour.
#
# docker-compose sets this to redis://redis:6379 for the app container and
# overrides whatever is here, because "localhost" inside a container is the
# container. Set it here for `npm run dev` against `npm run db:up`.
#
# Unset, the app behaves exactly as it did before: per-process buckets and
# local-only purges. /api/health reports which is in use.
REDIS_URL=

# ---- Clerk (admin login) — https://clerk.com ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Razorpay (test mode) — https://razorpay.com ----
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Brevo SMTP (transactional email) — https://brevo.com ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ekmool <orders@example.com>"

# ---- Sentry (error monitoring) — https://sentry.io ----
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for source-map upload in CI/deploys:
SENTRY_AUTH_TOKEN=

# ---- PostHog (product analytics) — https://posthog.com ----
NEXT_PUBLIC_POSTHOG_KEY=

# ---- Object storage for admin image upload (S3-compatible) ----
# Cloudflare R2 is the recommendation: no egress charge, and the free tier
# covers a shop this size outright. Any S3-compatible endpoint works —
# MinIO, Backblaze B2, AWS S3 — because the signing is hand-rolled SigV4
# against a PATH-STYLE URL (<endpoint>/<bucket>/<key>). No SDK and no npm
# dependency; see src/lib/storage.ts.
#
# ALL FIVE or none. A partial set counts as unconfigured: the file picker in
# /admin does not appear and photographs are attached by path under
# public/images/products/, which is how the five launch products work.
#
# S3_PUBLIC_BASE_URL is where the object is READ from, and it is separate on
# purpose — the signing endpoint is not usually a public origin. On R2 it is
# your custom domain, or the bucket's r2.dev URL. Without it an upload would
# succeed and then be unreachable, so the code treats its absence as "no
# storage configured".
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# R2 ignores the region; the signature still needs one. Leave it as "auto".
S3_REGION=auto

# ---- Backups ----
# The nightly dump runs in the `backup` compose service (on the mysql:8.4
# image, because Alpine's MySQL client cannot authenticate to MySQL 8.4 —
# see docker/backup.sh). It writes here, verifies the archive is whole, and
# prunes local copies past BACKUP_KEEP_DAYS.
#
# The upload to object storage reuses the S3_* settings above and runs from
# the cron container at 04:00 IST. With no bucket configured the backup
# still happens and is still verified; it just stays on disk.
#
# Remote retention is deliberately NOT done by the script. Set a lifecycle
# rule on the bucket instead — docs/deploy.md has the R2 one.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_AT_HOUR_IST=3

# ---- Uptime monitoring ----
# `npm run uptime -- https://your-site` polls /api/health. A hosted monitor
# is the better answer for most shops — it notices when the whole machine
# is gone, which a process on that machine cannot — and docs/deploy.md says
# so. This is for when you want one anyway.
#
# Any endpoint that accepts a JSON POST: a Slack or Discord incoming
# webhook reads the `text` field directly. Unset, alerts are logged to the
# console and nowhere else, and it says so on startup.
UPTIME_WEBHOOK_URL=
UPTIME_INTERVAL=60
UPTIME_THRESHOLD=2
