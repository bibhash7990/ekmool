# ------------------------------------------------------------------
# EKMOOL environment template
# Copy to .env.local and fill in. Every third-party section is OPTIONAL:
# the site builds, runs, and takes COD orders with none of them set.
# Signup steps for each service: docs/keys-needed.md
# ------------------------------------------------------------------

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Protects /api/jobs/* (header: x-cron-secret). Generate: openssl rand -hex 32
CRON_SECRET=
# Protects /api/revalidate (header: x-revalidate-secret)
REVALIDATE_SECRET=
# Receives low-stock reports and admin alerts
ADMIN_EMAIL=

# ---- Database (MySQL 8 — `npm run db:up` starts the Docker container) ----
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=ekmool
DATABASE_PASSWORD=ekmool_dev
DATABASE_NAME=ekmool
# Used only by docker-compose + scripts, never by the app:
MYSQL_ROOT_PASSWORD=ekmool_root_dev

# ---- Clerk (admin login) — https://clerk.com ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Razorpay (test mode) — https://razorpay.com ----
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Brevo SMTP (transactional email) — https://brevo.com ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ekmool <orders@example.com>"

# ---- Sentry (error monitoring) — https://sentry.io ----
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for source-map upload in CI/deploys:
SENTRY_AUTH_TOKEN=

# ---- PostHog (product analytics) — https://posthog.com ----
NEXT_PUBLIC_POSTHOG_KEY=
