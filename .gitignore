# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
# ...except the database provider's CA certificate. A CA cert is public by
# design — it is what verifies the server, and it carries no secret — and
# committing it is what lets a hosted build read it from disk instead of an
# env var. Vercel's dashboard strips the newlines out of a pasted PEM,
# which OpenSSL then rejects. The blanket *.pem rule stays for private
# keys, which must never be committed.
!ca.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is the committed template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# sentry
.sentryclirc

# audit artifacts (JSON reports are large; summaries live in docs/)
/research/audits/*.json
/research/audits/*.html
/research/loadtest/*.json

# generated by scripts/loadtest.mjs from the live database
/scripts/k6/data/
