# Expo SDK 54+ supports pnpm's default isolated store, and SDK 56's
# on-demand filesystem removed the watchFolders workaround that used to make
# it painful. Not hoisting: apps/web is on React 19.2.8 and apps/mobile will
# be on the 19.2.3 that Expo SDK 57 pins, and isolation is what keeps those
# apart cleanly.
#
# `node-linker=hoisted` was tried during the conversion, for a Windows
# standalone-boot failure, and it does NOT fix it — pnpm keeps the .pnpm
# store and its symlinks whatever the linker is, so the hoisted layout
# changes only the top level. The real cause and its fix are in
# apps/web/scripts/standalone.mjs (repairWindowsSymlinks). Recorded here so
# nobody reaches for the linker again on the same symptom.
node-linker=isolated

# Not a preference. React Native's peer ranges routinely lag the SDK that
# ships them, so a strict install fails on warnings Expo itself considers
# correct.
strict-peer-dependencies=false
