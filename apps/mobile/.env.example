# Copy to .env.local. Every variable here is compiled into the app bundle
# and can be read out of a shipped APK with a zip tool — EXPO_PUBLIC_* is
# exactly as public as NEXT_PUBLIC_* and docs/SECURITY.md's rule is the
# same. No secret belongs in this file, now or later.

# Where the app talks to. No host is hardcoded anywhere else in the app.
#
# A device is not the machine running the server, so "localhost" reaches the
# phone itself and nothing else. Use the development machine's LAN address
# for a physical device, or http://10.0.2.2:3000 for the Android emulator,
# which is how the emulator addresses its host.
#
# Unset, the app falls back to the production origin — see src/api/client.ts.
EXPO_PUBLIC_API_URL=

# EAS project id, injected into `extra.eas.projectId` by app.config.js.
# Created by `eas init`; not a secret, but per-account, so it is not checked
# in. Only needed once Phase 6 starts building.
EAS_PROJECT_ID=
