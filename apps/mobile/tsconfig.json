{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // Not `extends: ../../tsconfig.base.json`, and that is deliberate rather
    // than an oversight. Expo's base sets the module resolution, the JSX
    // transform and the lib set that React Native actually needs — `lib:
    // ["dom"]` from the workspace base would make `document` and `window`
    // typecheck in a runtime that has neither, which is exactly the error a
    // typechecker is here to catch. The options that matter to this project
    // are restated below instead of inherited.
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // For app.config.js alone, and only because eas-cli cannot parse a
    // TypeScript config — see the header comment in that file. Without
    // `checkJs` the JSDoc annotation there is decoration; with it, `tsc
    // --noEmit` still catches a key that SDK 57 removed, which is the check
    // that earned its place twice already. `include` below names the single
    // file rather than `**/*.js`, so this does not quietly start checking
    // eslint.config.mjs or anything else that arrives later.
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "app.config.js",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
