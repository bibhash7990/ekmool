{
  "name": "ekmool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:schema": "node scripts/validate-seo.mjs",
    "test:checkout": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-checkout.mjs",
    "test:db-down": "node scripts/test-db-down.mjs",
    "test:jobs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-jobs.mjs",
    "cron": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cron-runner.mts",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose stop mysql",
    "db:migrate": "node scripts/db-migrate.mts",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-seed.mts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.4",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/nextjs": "^10.69.0",
    "@types/mdx": "^2.0.14",
    "mysql2": "^3.23.2",
    "next": "16.3.0",
    "nodemailer": "^9.0.3",
    "posthog-js": "^1.410.6",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "^9.3.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "ulidx": "^2.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "node-cron": "^4.6.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
